# Copy this file to `.env` and adjust the values for your environment.

# --- Grants.gov data source ------------------------------------------------------
# "extract" (default) downloads the full daily XML database extract (every
# opportunity, ~75 MB zip); "export" uses the search_export JSON endpoint,
# capped at GRANTS_GOV_ROWS rows.
GRANTS_DATA_SOURCE=extract
# How many days back to look for a published extract if today's is missing (default: 3)
GRANTS_GOV_EXTRACT_LOOKBACK_DAYS=3

# --- Grants.gov export settings -------------------------------------------------
# Maximum records to request in a single export call (default: 5000)
GRANTS_GOV_ROWS=5000
# Optional keyword/filters (leave blank to disable)
GRANTS_GOV_QUERY=
GRANTS_GOV_CFDA=
GRANTS_GOV_AGENCIES=
GRANTS_GOV_ELIGIBILITIES=
GRANTS_GOV_FUNDING_CATEGORIES=
GRANTS_GOV_FUNDING_INSTRUMENTS=
GRANTS_GOV_DATE_RANGE=
# Pipe-delimited statuses (e.g., "posted|forecasted")
GRANTS_GOV_OPP_STATUSES=forecasted|posted
# Request timeout in seconds
GRANTS_GOV_TIMEOUT=60

# --- Filtering and relevance ----------------------------------------------------
# The research profile (config/research_profile.yml) holds the keywords,
# agency exclusions, and notification threshold. These variables override it.
GRANTS_PROFILE_FILE=
# Text overrides for hosted runs where the local profile file is absent
GRANTS_PROFILE_SUMMARY=
GRANTS_PROFILE_INSTITUTION=
GRANTS_KEYWORDS=
GRANTS_KEYWORD_THRESHOLD=
GRANTS_INCLUDE_FORECAST=
GRANTS_MIN_SCORE=
GRANTS_GOV_LOOKBACK_DAYS=90

# Relevance scoring talks to any OpenAI-compatible server: Ollama
# (http://localhost:11434/v1), vLLM (http://host:8000/v1), LM Studio, etc.
# Scoring stays off until the profile summary is filled in AND a model is named.
GRANTS_LLM_BASE_URL=http://localhost:11434/v1
GRANTS_LLM_MODEL=
GRANTS_LLM_API_KEY=ollama
GRANTS_LLM_BATCH_SIZE=4
GRANTS_LLM_WORKERS=2
GRANTS_LLM_TIMEOUT=180
GRANTS_RELEVANCE_MAX_PER_RUN=400

# --- Gmail notifications --------------------------------------------------------
GMAIL_TOKEN_FILE=path/to/token.json
GMAIL_NOTIFY_RECIPIENTS=recipient@example.com
GMAIL_SENDER_EMAIL=
GMAIL_SUBJECT=GrantWatch: new opportunities posted
GMAIL_USER_AGENT=

# --- PostgreSQL connection ------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=grantwatch
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
# Or a single DSN (Neon, Vercel Postgres): POSTGRES_URL=postgresql://...
POSTGRES_CONNECT_TIMEOUT=10

# --- Document checker ---
DOC_CHECKER_BUCKET=grant-doc-checker-temp-dev
DOC_CHECKER_TABLE=grant-doc-checker-submissions-dev
DOC_CHECKER_ALLOWED_ORIGINS=http://localhost:3000
DOC_CHECKER_DEFAULT_MAX_MB=25
DOC_CHECKER_DEFAULT_MAX_PAGES=50
DOC_CHECKER_PRESIGN_SECONDS=900
DOC_CHECKER_TTL_DAYS=2
DOC_CHECKER_ENABLE_TEXTRACT=false
# Optional shared secret; when set, POST /start-submission and /upload-url
# require an X-Upload-Token header with this value
DOC_CHECKER_UPLOAD_TOKEN=
