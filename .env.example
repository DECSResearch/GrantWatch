# Copy this file to `.env` and adjust the values for your environment.

# --- Grants.gov data source ------------------------------------------------------
# "extract" (default) downloads the full daily XML database extract (every
# opportunity, ~75 MB zip); "export" uses the search_export JSON endpoint,
# capped at GRANTS_GOV_ROWS rows.
GRANTS_DATA_SOURCE=extract
# How many days back to look for a published extract if today's is missing (default: 3)
GRANTS_GOV_EXTRACT_LOOKBACK_DAYS=3

# --- Grants.gov export settings -------------------------------------------------
# Maximum records to request in a single export call (default: 5000)
GRANTS_GOV_ROWS=5000
# Optional keyword/filters (leave blank to disable)
GRANTS_GOV_QUERY=
GRANTS_GOV_CFDA=
GRANTS_GOV_AGENCIES=
GRANTS_GOV_ELIGIBILITIES=
GRANTS_GOV_FUNDING_CATEGORIES=
GRANTS_GOV_FUNDING_INSTRUMENTS=
GRANTS_GOV_DATE_RANGE=
# Pipe-delimited statuses (e.g., "posted|forecasted")
GRANTS_GOV_OPP_STATUSES=forecasted|posted
# Request timeout in seconds
GRANTS_GOV_TIMEOUT=60

# --- Filtering and relevance ----------------------------------------------------
# The research profile (config/research_profile.yml) holds the keywords,
# agency exclusions, and notification threshold. These variables override it.
GRANTS_PROFILE_FILE=
# Text overrides for hosted runs where the local profile file is absent
GRANTS_PROFILE_SUMMARY=
GRANTS_PROFILE_INSTITUTION=
GRANTS_KEYWORDS=
GRANTS_KEYWORD_THRESHOLD=
GRANTS_INCLUDE_FORECAST=
GRANTS_MIN_SCORE=
GRANTS_OVERVIEW_DAY=
# Only grants posted in the last N days; empty or 0 keeps every open grant
# (long-running NSF solicitations were posted years ago).
GRANTS_GOV_LOOKBACK_DAYS=

# Relevance scoring talks to any OpenAI-compatible server: Ollama
# (http://localhost:11434/v1), vLLM (http://host:8000/v1), LM Studio, etc.
# Scoring stays off until the profile summary is filled in AND a model is named.
GRANTS_LLM_BASE_URL=http://localhost:11434/v1
GRANTS_LLM_MODEL=
GRANTS_LLM_API_KEY=ollama
GRANTS_LLM_BATCH_SIZE=4
GRANTS_LLM_WORKERS=2
GRANTS_LLM_TIMEOUT=180
GRANTS_RELEVANCE_MAX_PER_RUN=400
# Completion tokens per request; reasoning models that think first need more
# (8192 works for Qwen 3.x), or turn their thinking off with the next line.
GRANTS_LLM_MAX_TOKENS=
# JSON merged into each request. For Qwen 3.x on vLLM or Open WebUI this turns
# thinking off, about 9x faster with near-identical scores:
# GRANTS_LLM_EXTRA_BODY={"chat_template_kwargs": {"enable_thinking": false}}
GRANTS_LLM_EXTRA_BODY=

# --- Email ------------------------------------------------------------------------
# Team members; merged into the recipients table on every run (an unsubscribe
# sticks). Manage them with `python main.py recipients add|remove|list`.
GRANTS_NOTIFY_RECIPIENTS=you@example.edu
GRANTS_EMAIL_FROM=GrantWatch <you@example.edu>
# Public URL of the dashboard; needed for unsubscribe and sign-in links.
GRANTS_DASHBOARD_URL=
# Cap on new grants per email; the rest follow in the next emails.
GRANTS_EMAIL_MAX_NEW=25
# Pick one way to send. smtp, gmail, or outbox (writes .eml files to a folder).
# Left empty, the first one configured below is used.
GRANTS_EMAIL_TRANSPORT=
# SMTP: Gmail (smtp.gmail.com with an app password), Microsoft 365
# (smtp.office365.com), AWS SES, Postmark, ...
GRANTS_SMTP_HOST=
GRANTS_SMTP_PORT=587
GRANTS_SMTP_SECURITY=starttls
GRANTS_SMTP_USER=
GRANTS_SMTP_PASSWORD=
# Gmail API with an OAuth token from scripts/generate_gmail_token.py; on a
# server, put the token's contents in GMAIL_TOKEN_JSON instead.
GMAIL_TOKEN_FILE=
GMAIL_TOKEN_JSON=
# Folder for the outbox transport (dry runs, local testing).
GRANTS_EMAIL_OUTBOX=

# --- Dashboard sign-in -----------------------------------------------------------
# Signs sign-in links and session cookies; 16+ random characters, e.g. from
# `python -c "import secrets; print(secrets.token_urlsafe(32))"`. Without it
# the dashboard is read-only.
GRANTS_SECRET_KEY=

# --- Admin page ------------------------------------------------------------------
# Password for /admin/ (HTTP Basic, any username): job runs and their logs, the
# model server, email, the team and the settings. 16 or more ASCII letters and
# digits: the server decodes Basic credentials as ASCII, so a non-ASCII password
# can never sign in. Left empty, a placeholder starting with REPLACE, or shorter
# than 16, the page is off (503). Over plain HTTP it is sent unencrypted, so use
# a password you use nowhere else.
GRANTS_ADMIN_PASSWORD=
# The time zone that decides which day an email counts for on that page.
# GRANTS_TIMEZONE=America/Chicago

# --- PostgreSQL connection ------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=grantwatch
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
# Or a single DSN (Neon, Vercel Postgres): POSTGRES_URL=postgresql://...
POSTGRES_CONNECT_TIMEOUT=10

# --- Document checker ---
DOC_CHECKER_BUCKET=grant-doc-checker-temp-dev
DOC_CHECKER_TABLE=grant-doc-checker-submissions-dev
DOC_CHECKER_ALLOWED_ORIGINS=http://localhost:3000
DOC_CHECKER_DEFAULT_MAX_MB=25
DOC_CHECKER_DEFAULT_MAX_PAGES=50
DOC_CHECKER_PRESIGN_SECONDS=900
DOC_CHECKER_TTL_DAYS=2
DOC_CHECKER_ENABLE_TEXTRACT=false
# Optional shared secret; when set, POST /start-submission and /upload-url
# require an X-Upload-Token header with this value
DOC_CHECKER_UPLOAD_TOKEN=
